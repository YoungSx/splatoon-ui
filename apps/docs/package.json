{
  "name": "@splatoon-ui/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 4317",
    "build": "next build",
    "build:demo": "NEXT_OUTPUT_MODE=export next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs:api": "node scripts/generate-docs-api.mjs",
    "docs:examples": "node scripts/generate-docs-examples.mjs",
    "docs:generate": "pnpm docs:api && pnpm docs:examples",
    "docs:check": "node scripts/generate-docs-api.mjs --check && node scripts/generate-docs-examples.mjs --check && node scripts/check-docs-registry.mjs",
    "reference:crawl": "node ../../scripts/collect-splatoon-reference.mjs --locale en --maxPages 80 --outputDir ../../scratch/splatoon-reference",
    "reference:crawl:all": "node ../../scripts/collect-splatoon-reference.mjs --locale en --maxPages all --outputDir ../../scratch/splatoon-reference",
    "reference:crawl:all-locales": "node ../../scripts/collect-splatoon-reference.mjs --locale all --maxPages all --outputDir ../../scratch/splatoon-reference-all-locales",
    "reference:crawl:download": "node ../../scripts/collect-splatoon-reference.mjs --locale en --maxPages 80 --download-assets --outputDir ../../scratch/splatoon-reference",
    "reference:analyze": "node ../../scripts/analyze-splatoon-reference.mjs --referenceDir ../../scratch/splatoon-reference",
    "reference:analyze:all-locales": "node ../../scripts/analyze-splatoon-reference.mjs --referenceDir ../../scratch/splatoon-reference-all-locales",
    "reference:analyze:videos": "node ../../scripts/analyze-splatoon-videos.mjs --referenceDir ../../scratch/splatoon-reference-all-locales",
    "reference:analyze:videos:probe": "node ../../scripts/analyze-splatoon-videos.mjs --referenceDir ../../scratch/splatoon-reference-all-locales --probe",
    "test:docs-smoke": "node tests/docs-smoke-regression.mjs",
    "test:docs-visual": "node tests/docs-visual-regression.mjs",
    "test:docs-visual-smoke": "node tests/docs-visual-smoke-all.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.2.7",
    "@radix-ui/react-progress": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "splatoon-ui": "workspace:*",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  }
}
