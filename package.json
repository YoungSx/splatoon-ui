{
  "name": "splatoon-ui",
  "version": "0.1.0",
  "description": "A React component library inspired by Splatoon's visual language.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/YoungSx/splatoon-ui.git"
  },
  "homepage": "https://github.com/YoungSx/splatoon-ui#readme",
  "bugs": {
    "url": "https://github.com/YoungSx/splatoon-ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "splatoon",
    "tailwindcss"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "public/_images",
    "public/fonts",
    "public/svgs",
    "README.md",
    "README_EN.md",
    "README_JA.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/server.js",
  "module": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./styles.css": "./dist/styles.css",
    "./assets/*": "./public/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 4317",
    "build": "next build",
    "build:package": "tsup && node scripts/build-package-styles.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "reference:crawl": "node scripts/collect-splatoon-reference.mjs --locale en --maxPages 80",
    "reference:crawl:all": "node scripts/collect-splatoon-reference.mjs --locale en --maxPages all",
    "reference:crawl:all-locales": "node scripts/collect-splatoon-reference.mjs --locale all --maxPages all --outputDir scratch/splatoon-reference-all-locales",
    "reference:crawl:download": "node scripts/collect-splatoon-reference.mjs --locale en --maxPages 80 --download-assets",
    "reference:analyze": "node scripts/analyze-splatoon-reference.mjs",
    "reference:analyze:all-locales": "node scripts/analyze-splatoon-reference.mjs --referenceDir scratch/splatoon-reference-all-locales",
    "reference:analyze:videos": "node scripts/analyze-splatoon-videos.mjs",
    "reference:analyze:videos:probe": "node scripts/analyze-splatoon-videos.mjs --probe",
    "test:demo-smoke": "node tests/demo-smoke-regression.mjs",
    "test:package-consumer": "node tests/package-consumer-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run build:package",
    "release": "pnpm typecheck && node tests/ui-entrypoints-regression.mjs && node tests/package-publish-regression.mjs && pnpm build:package && pnpm pack:dry-run && pnpm test:package-consumer"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@radix-ui/react-progress": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "next": "16.2.7",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5"
  }
}
