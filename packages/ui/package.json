{
  "name": "splatoon-ui",
  "version": "0.2.0",
  "description": "A React component library inspired by Splatoon's visual language.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/YoungSx/splatoon-ui.git"
  },
  "homepage": "https://github.com/YoungSx/splatoon-ui#readme",
  "bugs": {
    "url": "https://github.com/YoungSx/splatoon-ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "splatoon",
    "tailwindcss"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "public/_images/backgrounds",
    "public/_images/banners",
    "public/_images/characters",
    "public/_images/events",
    "public/_images/news",
    "public/_images/squid",
    "public/_images/svg",
    "public/_images/tape-assets",
    "public/_images/weapons",
    "public/fonts",
    "public/svgs",
    "README.md",
    "README_ZH.md",
    "README_JA.md",
    "LICENSE",
    "NOTICE",
    "CREDITS.md"
  ],
  "main": "./dist/server.js",
  "module": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./alert": {
      "types": "./dist/alert.d.ts",
      "import": "./dist/alert.js"
    },
    "./badge": {
      "types": "./dist/badge.d.ts",
      "import": "./dist/badge.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./button-group": {
      "types": "./dist/button-group.d.ts",
      "import": "./dist/button-group.js"
    },
    "./icon-button": {
      "types": "./dist/icon-button.d.ts",
      "import": "./dist/icon-button.js"
    },
    "./wave-button": {
      "types": "./dist/wave-button.d.ts",
      "import": "./dist/wave-button.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "import": "./dist/card.js"
    },
    "./staple-card": {
      "types": "./dist/staple-card.d.ts",
      "import": "./dist/staple-card.js"
    },
    "./torn-card": {
      "types": "./dist/torn-card.d.ts",
      "import": "./dist/torn-card.js"
    },
    "./rugged-card": {
      "types": "./dist/rugged-card.d.ts",
      "import": "./dist/rugged-card.js"
    },
    "./carousel": {
      "types": "./dist/carousel.d.ts",
      "import": "./dist/carousel.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./label": {
      "types": "./dist/label.d.ts",
      "import": "./dist/label.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./radio-group": {
      "types": "./dist/radio-group.d.ts",
      "import": "./dist/radio-group.js"
    },
    "./progress": {
      "types": "./dist/progress.d.ts",
      "import": "./dist/progress.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js"
    },
    "./segmented-control": {
      "types": "./dist/segmented-control.d.ts",
      "import": "./dist/segmented-control.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "import": "./dist/popover.js"
    },
    "./sheet": {
      "types": "./dist/sheet.d.ts",
      "import": "./dist/sheet.js"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "import": "./dist/switch.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./list": {
      "types": "./dist/list.d.ts",
      "import": "./dist/list.js"
    },
    "./section": {
      "types": "./dist/section.d.ts",
      "import": "./dist/section.js"
    },
    "./banner-divider": {
      "types": "./dist/banner-divider.d.ts",
      "import": "./dist/banner-divider.js"
    },
    "./dotted-divider": {
      "types": "./dist/dotted-divider.d.ts",
      "import": "./dist/dotted-divider.js"
    },
    "./splatoon-title": {
      "types": "./dist/splatoon-title.d.ts",
      "import": "./dist/splatoon-title.js"
    },
    "./heading-tape": {
      "types": "./dist/heading-tape.d.ts",
      "import": "./dist/heading-tape.js"
    },
    "./tape-title": {
      "types": "./dist/tape-title.d.ts",
      "import": "./dist/tape-title.js"
    },
    "./tape": {
      "types": "./dist/tape.d.ts",
      "import": "./dist/tape.js"
    },
    "./wave-canvas": {
      "types": "./dist/wave-canvas.d.ts",
      "import": "./dist/wave-canvas.js"
    },
    "./styles.css": "./dist/styles.css",
    "./assets/*": "./public/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:package",
    "build:package": "tsup && node scripts/build-package-styles.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "pnpm build:package"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@radix-ui/react-progress": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "tsup": "^8.5.1",
    "typescript": "^5"
  }
}
